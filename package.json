{
  "name": "slackline",
  "version": "0.1.0",
  "description": "A Slack agent that turns requests into Linear tickets, then does the work: code changes as pull requests, writing, or your own tools.",
  "main": "src/agent.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node bin/slackline.mjs demo",
    "start": "node --env-file=.env bin/slackline.mjs start"
  },
  "keywords": [
    "slack",
    "linear",
    "agent",
    "claude",
    "automation"
  ],
  "author": "Mrunali Yadav",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@linear/sdk": "^103.0.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "slackline": "bin/slackline.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrunaliyadavps/slackline"
  }
}
