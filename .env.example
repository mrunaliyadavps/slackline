# Slack: Bot token (xoxb-) and an app-level token with connections:write (xapp-)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Linear: a personal API key, and the team new tickets go to
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Claude
ANTHROPIC_API_KEY=
# SLACKLINE_MODEL=claude-sonnet-5-5

# Code work (optional): repos the agent may change, as owner/name, comma separated.
# GITHUB_TOKEN needs contents:write and pull_requests:write on those repos.
SLACKLINE_REPOS=
GITHUB_TOKEN=
# Command the agent runs to check its work, e.g. "npm ci && npm test"
SLACKLINE_TEST_COMMAND=

# Who may give it work (Slack user and channel IDs, comma separated). Empty = anyone.
SLACKLINE_ALLOWED_USERS=
SLACKLINE_ALLOWED_CHANNELS=

# 1 = file tickets and do the work, but never push code or call real actions
SLACKLINE_DRY_RUN=1
# SLACKLINE_MAX_TURNS=25
